<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. No other capabilities are needed:
         IOKit power assertions, power-source info, notifications and
         SMAppService all work inside the sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
